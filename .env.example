# ---------------------------------------------------------------
# Copia este archivo como .env.local y completa los valores.
# ---------------------------------------------------------------

# OPCIÓN A — PostgreSQL propio (recomendado en tu servidor)
# Formato: postgresql://USUARIO:CLAVE@HOST:PUERTO/BASE
DATABASE_URL=postgresql://padron:CAMBIA_ESTA_CLAVE@localhost:5432/padron
# Pon true solo si tu PostgreSQL exige SSL (servicios administrados)
DATABASE_SSL=false

# OPCIÓN B — Supabase (deja DATABASE_URL vacío para usar esta)
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Si tu sitio NO usa HTTPS (por ejemplo, red local http://192.168.x.x),
# pon false para que el inicio de sesión funcione. Con HTTPS déjalo vacío.
# COOKIE_SECURE=false
